# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://athar:change_me@localhost:5432/athar?schema=public"

# ── JWT (generate each with: openssl rand -base64 48) ────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── HTTP security ────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in development.
CORS_ORIGIN=http://localhost:8081

# Rate limiting: max requests per window per IP (window in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
